# GCP project setup
billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
org_id             = ""  # Leave empty if no org, or set to numeric org ID
folder_id          = ""  # Leave empty for org root

project_id   = "cloud-8021x"
project_name = "Cloud RADIUS 802.1X"

# Region / zones — primary and secondary VMs run in different zones for HA
region         = "us-east4"
zone           = "us-east4-a"
secondary_zone = "us-east4-c"

# VM sizing — FreeRADIUS + MariaDB need ~2 GB RAM
machine_type = "e2-medium"
disk_size_gb = 50

# Per-office RADIUS clients
# CIDRs may cover a routed AP/VPN subnet. For changing public WAN IPs, set
# unifi_host_id to the exact gateway/console ID from UniFi /v1/hosts; this
# requires unifi_api_key. CIDRs and discovery can be combined per office.
# nyc = { unifi_host_id = "<gateway host ID>", cidrs = ["10.20.0.0/16"] }
# Each office gets a unique shared secret auto-generated by Terraform
# and stored in Secret Manager as "radius-shared-secret-<key>".
# Retrieve with: gcloud secrets versions access latest --secret=radius-shared-secret-nyc --project=<project-id>
radius_clients = {
  nyc = {
    cidrs       = ["203.0.113.1/32"]
    description = "NYC Ubiquiti UniFi APs"
  }
  atl = {
    cidrs       = ["203.0.113.2/32", "203.0.113.3/32"]
    description = "ATL Ubiquiti UniFi APs"
  }
  branch-office = {
    cidrs       = ["203.0.113.4/32"]
    description = "Branch office Ubiquiti UniFi APs"
  }
}

# SSH access — default is GCP IAP tunnel only.
ssh_allowed_cidrs = [
  "35.235.240.0/20",    # GCP IAP range (for gcloud ssh --tunnel-through-iap)
  # "203.0.113.10/32",  # Optional: add your IP for direct SSH access
]

# RADIUS server certificate
# CN must match the Jamf WiFi profile "Trusted Server Certificate Names"
# Org is used in the CA and server cert subject (e.g. /O=Acme Corp/CN=...)
server_cert_cn  = "radius.example.com"
server_cert_org = "Example Corp"

# Datadog monitoring
# The agent collects infrastructure metrics, FreeRADIUS metrics (via Prometheus exporter),
# and ships logs to Datadog SIEM.
datadog_api_key = "CHANGE-ME-your-datadog-api-key"
# datadog_site    = "us5.datadoghq.com"  # default; uncomment to override
# datadog_app_key = "your-datadog-app-key"  # enables Terraform-managed dashboard; scope to dashboards_read + dashboards_write

# Fleet device owner lookup (optional) — the Fleet-managed counterpart of the
# Jamf lookup below. Enriches RADIUS auth logs with the assigned user's email,
# device name, and model, resolved from Fleet by serial. The API token is NOT a
# variable — store it out-of-band in the `fleet-api-token` Secret Manager secret
# (Observer for lookup/ACME; scoped maintainer for certificate collection).
# Mutually exclusive with the Jamf lookup below — set one MDM source, not both.
# enable_fleet_lookup = true
# fleet_api_base_url  = "https://fleet.example.com"
# rewrite_username    = true   # reply:User-Name -> "email<sep>serial" (shown as 802.1X Identity in UniFi)

# Jamf Pro device owner lookup (optional)
# Enriches RADIUS auth logs with the assigned user's email.
# Also overwrites the EAP identity so UniFi/accounting shows email instead of serial number.
# Requires a Jamf Pro API Client with "Read Computers" privilege.
# Mutually exclusive with the Fleet lookup above.
# jamf_url           = "https://yourorg.jamfcloud.com"
# jamf_client_id     = "your-api-client-id"
# jamf_client_secret = "your-api-client-secret"
# rewrite_username   = true     # set reply:User-Name to "email<sep>serial" in Access-Accept (shown as 802.1X Identity in UniFi)
# rewrite_username_separator = " - "  # separator between email and serial (default: " - ")

# TLS session caching — speeds up legacy EAP-TLS re-authentication.
# Fingerprint enforcement always disables resumption, regardless of this setting.
# tls_session_cache          = true   # default: true (set false to disable)
# tls_session_cache_lifetime = 24     # cache lifetime in hours (default: 24)
# tls_max_version            = "1.2"  # "1.2" (default, enables disk-based session cache) or "1.3"

# Okta Intermediate CA certificate (PEM format)
# This is the trust anchor for SCEP client certs issued via Jamf/Okta.
# Paste full PEM, or use -var-file input with a literal PEM value.
# For Smallstep-only deployments, replace this assignment with okta_ca_cert_pem = "".
okta_ca_cert_pem = <<-EOT
-----BEGIN CERTIFICATE-----
PASTE YOUR OKTA INTERMEDIATE CA CERTIFICATE HERE
-----END CERTIFICATE-----
EOT

# Okta Root CA certificate (optional, PEM format)
# Enables full chain validation: client cert → Intermediate → Root.
# Without this, FreeRADIUS trusts only the Intermediate CA directly (still works).
# See README for instructions on obtaining this from your Okta admin console.
# okta_root_ca_cert_pem = <<-EOT
# -----BEGIN CERTIFICATE-----
# PASTE YOUR OKTA ROOT CA CERTIFICATE HERE
# -----END CERTIFICATE-----
# EOT

# --- Optional self-hosted Smallstep step-ca (default: disabled) ---
# enable_smallstep_ca              = false
# radius_trust_mode                = "okta"      # flip to "smallstep" only after pre-staging certs
# smallstep_ca_dns_name            = "ca.example.com"
# smallstep_acme_provisioner_name  = "wifi-acme"   # must be globally unique (≠ scep name)
# smallstep_scep_rsa_provisioner_name = "wifi-scep"   # step-ca rejects duplicate provisioner names
# enable_acme_webhook             = true        # required authorization gate before real enrollment
# acme_authorizing_webhook_url     = ""          # uses managed loopback HTTPS when webhook enabled
# smallstep_db_tier                = "db-custom-1-3840"  # standard tier required for REGIONAL HA

# DNS name for the RSA SCEP step-ca instance (Windows + serial-free Apple BYOD). Point an
# A record at the `smallstep_rsa_lb_ip` output. Required when enable_smallstep_ca=true.
# smallstep_ca_rsa_dns_name = "ca-rsa.example.com"

# Dynamic VLAN assignment (UniFi and other RFC 3580 RADIUS clients).
# Keys are adapter-defined groups: Fleet fleet/team IDs or Jamf computer site IDs.
# Enable one inventory lookup above, or provide your own normalized cache_file.
# radius_vlan_policy = {
#   group_vlans = {
#     "fleet:1" = 100 # Staff fleet
#     "fleet:2" = 200 # BYOD fleet
#     # "jamf:site:3" = 100
#   }
#   # fallback_vlan = 999 # Known enrolled devices with no mapped group only.
#   cache_max_age = 3600 # Reject if no complete inventory refresh for an hour.
# }

# Recommended Fleet dynamic SCEP + fingerprint authorization. Stage collection
# and verify coverage on BOTH nodes before enabling the policy. Requires the
# self-hosted CA/webhook above and radius_trust_mode = "smallstep" or "both".
# See docs/scep-identity-binding.md; do not combine this policy with the one above.
# enable_fleet_lookup                = true
# enable_fleet_certificate_inventory = true
# Separate scoped maintainer secret; keep fleet-api-token observer-only.
# fleet_certificate_token_secret_id = "fleet-certificate-inventory-token"
# fleet_api_base_url                 = "https://fleet.example.com"
# scep_broker_requests_per_minute    = 1000 # Per Fleet outbound IP; excess gets HTTP 429, no timed ban.
# radius_vlan_policy = {
#   certificate_inventory = true
#   certificate_max_age   = 86400 # Minimum 7200 seconds: two hourly collection cycles.
#   cache_max_age         = 3600
#   locations = {
#     nyc = {
#       group_vlans = { "fleet:1" = 100, "fleet:2" = 200 }
#       vlan_names  = { "100" = "Secure", "200" = "Guest" } # Optional fallback log labels.
#     }
#     atl = {
#       group_vlans = { "fleet:1" = 110, "fleet:2" = 220 }
#       vlan_names  = { "110" = "Secure", "220" = "Guest" }
#     }
#     branch-office = { dynamic_vlans = false } # Use SSID network; still authorize devices.
#   }
# }
# Keys must match radius_clients. Location maps do not inherit global mappings.
# Every client on these servers needs an exact trusted fingerprint binding;
# existing ACME identities can be collected without reissuance.

# Automatic display-only VLAN names from the existing controller API keys.
# UniFi WAN-discovery host IDs are reused automatically; these explicit sources
# also work for offices defined only by static CIDRs. Pin a local site UUID if
# the console has multiple sites. The UniFi key must permit connector access.
# radius_vlan_name_sources = {
#   nyc = { unifi_host_id = "YOUR-NYC-CONSOLE-ID" }
#   atl = { unifi_host_id = "YOUR-ATL-CONSOLE-ID", unifi_site_id = "YOUR-LOCAL-SITE-UUID" }
#   # branch-office = { meraki_network_id = "N_YOUR-MERAKI-NETWORK-ID" }
# }
# Names refresh every five minutes, affect only logs, and do not enable VLANs
# at opted-out sites. Missing API names use optional vlan_names fallbacks.
